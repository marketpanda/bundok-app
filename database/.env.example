# Private backend URLs; never NEXT_PUBLIC_.
# Neon Connect: pooling on for DATABASE_URL, off for DIRECT_URL.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR_ENDPOINT-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@YOUR_ENDPOINT.REGION.aws.neon.tech/neondb?sslmode=require"
