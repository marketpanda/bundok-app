{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "prisma.config.ts",
    "src/**/*.ts",
    "scripts/**/*.ts",
    "generated/**/*.ts",
    "tests/**/*.ts"
  ]
}
