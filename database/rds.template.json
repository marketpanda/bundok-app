{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Ambangeg private RDS PostgreSQL in an existing VPC; schema migrations are applied separately.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "PrivateSubnetIds": {
      "Type": "List<AWS::EC2::Subnet::Id>",
      "Description": "At least two subnets in different AZs in the selected VPC."
    },
    "ClientSecurityGroupId": {
      "Type": "AWS::EC2::SecurityGroup::Id",
      "Description": "Backend or private administration host security group in the selected VPC."
    },
    "EngineVersion": {
      "Type": "String",
      "AllowedPattern": "17\\.[0-9]+",
      "Description": "An available PostgreSQL 17 minor version in your selected region; check describe-db-engine-versions."
    },
    "InstanceClass": {
      "Type": "String",
      "Default": "db.t4g.small",
      "AllowedValues": [
        "db.t4g.micro",
        "db.t4g.small",
        "db.t4g.medium"
      ]
    },
    "MultiAZ": {
      "Type": "String",
      "Default": "false",
      "AllowedValues": [
        "true",
        "false"
      ]
    }
  },
  "Conditions": {
    "UseMultiAZ": {
      "Fn::Equals": [
        {
          "Ref": "MultiAZ"
        },
        "true"
      ]
    }
  },
  "Resources": {
    "DatabaseSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "PostgreSQL access only from the Ambangeg backend/admin security group",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 5432,
            "ToPort": 5432,
            "SourceSecurityGroupId": {
              "Ref": "ClientSecurityGroupId"
            }
          }
        ]
      }
    },
    "DatabaseSubnetGroup": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "Private Ambangeg database subnets",
        "SubnetIds": {
          "Ref": "PrivateSubnetIds"
        }
      }
    },
    "DatabaseParameterGroup": {
      "Type": "AWS::RDS::DBParameterGroup",
      "Properties": {
        "Description": "Require TLS for Ambangeg PostgreSQL",
        "Family": "postgres17",
        "Parameters": {
          "rds.force_ssl": "1"
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot",
      "Properties": {
        "Engine": "postgres",
        "EngineVersion": {
          "Ref": "EngineVersion"
        },
        "DBName": "ambangeg",
        "DBInstanceClass": {
          "Ref": "InstanceClass"
        },
        "MasterUsername": "ambangeg_admin",
        "ManageMasterUserPassword": true,
        "AllocatedStorage": "20",
        "MaxAllocatedStorage": 100,
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "PubliclyAccessible": false,
        "DBSubnetGroupName": {
          "Ref": "DatabaseSubnetGroup"
        },
        "DBParameterGroupName": {
          "Ref": "DatabaseParameterGroup"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DatabaseSecurityGroup"
          }
        ],
        "BackupRetentionPeriod": 7,
        "DeletionProtection": true,
        "AutoMinorVersionUpgrade": true,
        "AllowMajorVersionUpgrade": false,
        "MultiAZ": {
          "Fn::If": [
            "UseMultiAZ",
            true,
            false
          ]
        },
        "CopyTagsToSnapshot": true,
        "EnableCloudwatchLogsExports": [
          "postgresql"
        ],
        "Tags": [
          {
            "Key": "Project",
            "Value": "Ambangeg"
          }
        ]
      }
    }
  },
  "Outputs": {
    "DatabaseEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DatabasePort": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Port"
        ]
      }
    },
    "AdminSecretArn": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "MasterUserSecret.SecretArn"
        ]
      }
    },
    "DatabaseSecurityGroupId": {
      "Value": {
        "Ref": "DatabaseSecurityGroup"
      }
    }
  }
}
