{
  "name": "ambangeg-database",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "generate": "prisma generate",
    "validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "db:inspect": "tsx scripts/inspect.ts",
    "db:status": "prisma migrate status",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "db:check": "tsx scripts/check.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/test-api-integration.ts",
    "api:build": "npm run generate && node scripts/build-api.mjs",
    "api:role": "tsx scripts/create-app-role.ts",
    "api:parameter": "tsx scripts/publish-parameter.ts",
    "test:bundle": "tsx scripts/test-bundle.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/client-ssm": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.0.0",
    "jpeg-js": "^0.4.4",
    "pg": "^8.16.0"
  },
  "devDependencies": {
    "@aws-sdk/client-lambda": "^3.1149.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "esbuild": "^0.28.2",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
