# Public Cognito identifiers (safe to include in a browser build; these are not secrets)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=ap-southeast-2_example
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=exampleclientid
NEXT_PUBLIC_COGNITO_DOMAIN=your-domain.auth.ap-southeast-2.amazoncognito.com

# Must exactly match a Cognito callback and sign-out URL, including the trailing slash.
NEXT_PUBLIC_APP_URL=http://localhost:3000/

# Public climbs API base URL. Never place a Neon connection string here.
NEXT_PUBLIC_CLIMBS_API_URL=https://2x47fd2ckf.execute-api.ap-southeast-2.amazonaws.com

# Public Amazon API Gateway endpoint created by infra/contact-form/template.yaml.
NEXT_PUBLIC_CONTACT_API_URL=https://example.execute-api.ap-southeast-2.amazonaws.com/contact

# Public site key for the Cloudflare Turnstile widget protecting the contact form.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
